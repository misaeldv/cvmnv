---
import BentoItem from './BentoItem.astro'
import Linkedin from './icons/Linkedin.astro'
import Github from './icons/Github.astro'
import { basics } from '../info.json'
import { Image } from 'astro:assets'
import Experiencia from './Experiencia.astro'
import AcercadeMi from './AcercadeMi.astro'
import TecnologiasGrid from './TecnologiasGrid.astro'
import Trabajo from './icons/Trabajo.astro'

const { name, label } = basics
---

<section id="inicio" class="max-w-[1200px] mx-auto mt-20 grid lg:grid-cols-5 lg:grid-rows-2 gap-3">
  <BentoItem class="lg:col-span-5 rounded-xl border-2 border-blue-800/10 bg-gray-200/[.04] drop-shadow-md flex flex-col">
    <div slot="content">
      <div class="relative flex flex-col lg:flex-row w-full h-full lg:justify-between justify-around">
        <div class="flex flex-col px-4 py-4 lg:p-8 justify-between">
          <div>
            <h1 class="text-xl lg:text-3xl font-semibold leading-10">{name}</h1>
            <h2 class="text-xs lg:text-base font-semibold bg-gradient-to-r from-yellow-500 via-yellow-50 to-yellow-50 inline-block text-transparent bg-clip-text">Entusiasta | Creativo | Optimista</h2>
          </div>
          <div class="flex-row flex gap-4 text-gray-300 mt-3 flex-wrap">
            <a target="_blank" class="ease-in-out hover:scale-110 transition flex items-center" href="https://www.linkedin.com/in/misaelnv">
              <Linkedin class="size-5 fill-slate-200" />
              <span class="ml-2 hidden sm:block">Linkedin</span>
            </a>
            <a target="_blank" class="hover:scale-110 transition ease-in-out flex items-center" href="https://github.com/owmisael">
              <Github class="size-6 fill-slate-200" />
              <span class="ml-2 hidden sm:block">Github</span>
            </a>
          </div>
          <p class="text-xs lg:text-base mt-4 text-gray-300 lg:leading-7">
            En constante búsqueda de oportunidades para crecer y evolucionar profesionalmente. 
            Apasionado por enfrentar nuevos desafíos y elevar proyectos web emocionantes al siguiente nivel. 
            Listo para aportar mi experiencia y creatividad en entornos dinámicos que requieran innovación y excelencia técnica.
          </p>
        </div>
        <div class="hidden lg:flex flex-col p-1 justify-between">
          <Image src="/img/avatar.jpg" alt="profile picture" class="object-fill rounded-r-lg" width="285" height="224" />
        </div>
      </div>
    </div>
  </BentoItem>

  <BentoItem class="lg:col-span-2 rounded-xl border-2 border-blue-800/10 bg-gray-200/[.04] drop-shadow-md flex flex-col">
    <div slot="content" class="h-full">
      <div class="flex flex-col justify-center items-center h-full">
        <span class="text-center">{label}</span>
      </div>
    </div>
  </BentoItem>

  <BentoItem class="lg:col-span-3 rounded-xl border-2 border-blue-800/10 bg-gray-200/[.04] drop-shadow-md flex flex-col">
    <div slot="content" class="px-4 py-2 lg:px-6 lg:py-4">
      <span class="purple_gradient font-bold text-2xl">Tecnologías</span>
      <TecnologiasGrid />
    </div>
  </BentoItem>
</section>

<section id="experiencia" class="max-w-[1200px] mx-auto mt-20">
  <h2 class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white">
    <Trabajo class="size-6" /> Experiencia laboral
  </h2>
  <Experiencia />
</section>

<section id="sobre-mi" class="max-w-[1200px] mx-auto mt-20">
  <AcercadeMi />
</section>