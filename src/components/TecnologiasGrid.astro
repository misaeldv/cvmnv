---
import Plsql from './icons/Plsql.astro'
import Sql from './icons/Sql.astro'
import Next from './icons/Next.astro'
import Apex from './icons/Apex.astro'
import Python from './icons/Python.astro'
import Oraclecloud from './icons/Oraclecloud.astro'
import Typescript from './icons/Typescript.astro'
import Tailwind from './icons/Tailwind.astro'
import Node from './icons/Node.astro'
import Supabase from './icons/Supabase.astro'
import Javascript from './icons/Javascript.astro'

const tecnologias = [
  { icon: Plsql, label: 'Pl/Sql' },
  { icon: Sql, label: 'Oracle Sql' },
  { icon: Apex, label: 'Oracle Apex' },
  { icon: Oraclecloud, label: 'Oracle Cloud' },
  { icon: Javascript, label: 'Javascript' },
  { icon: Next, label: 'Next js' },
  { icon: Node, label: 'Node js' },
  { icon: Supabase, label: 'Supabase' },
  { icon: Tailwind, label: 'Tailwind' },
  { icon: Typescript, label: 'TypeScript' },
  { icon: Python, label: 'Python' },
]
---

<div class="grid grid-cols-2 lg:grid-cols-6 gap-4 mt-6">
  {tecnologias.map(({ icon: Icon, label }) => (
    <div class="flex flex-col justify-center items-center">
      <div class="h-full w-full p-3">
        <Icon class="fill-slate-200" width="35" height="35" />
      </div>
      <span class="text-xs font-light">{label}</span>
    </div>
  ))}
</div>